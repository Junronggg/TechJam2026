# Copy this file to .env for local overrides. Do not commit .env.
TECHJAM_DATA_DIR=data/KuaiRand-Pure/data
TECHJAM_STARTER_DIR=kuairand-starter-kit
TECHJAM_ARTIFACT_DIR=artifacts
TECHJAM_LOG_DIR=logs
TECHJAM_SUBMISSION_DIR=submissions
PYTHONUTF8=1

# OpenAI-compatible LLM researcher. Never commit a real key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4.1-mini
