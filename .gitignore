# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Local secrets and machine-specific settings
.env

# KuaiRand data and downloaded archives (never commit competition data)
data/*
!data/.gitkeep
*.tar.gz
*.zip

# Generated experiment outputs
artifacts/*
!artifacts/.gitkeep
logs/*
!logs/.gitkeep
# Keep one explicitly curated, validation-only run archive for the submission.
!logs/run_final/
!logs/run_final/*.json
!logs/run_final/*.jsonl
submissions/*
!submissions/.gitkeep
runs/*
!runs/.gitkeep
best/*
!best/.gitkeep

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local archives of branch-specific generated outputs
local_archive/
