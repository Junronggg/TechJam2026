# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Local secrets and machine-specific settings
.env

# KuaiRand data and downloaded archives (never commit competition data)
data/*
!data/.gitkeep
*.tar.gz
*.zip

# Generated experiment outputs. Only the final evidence package is uploadable.
artifacts/*
!artifacts/.gitkeep
# Keep the small final-selection records needed to audit/reproduce a submission.
!artifacts/best_config.json
!artifacts/best_manifest.json
!artifacts/best_metrics.json
!artifacts/final_test_metrics.json
!artifacts/best_model.npz
logs/*
!logs/.gitkeep
# Keep compact audit records for the selected runs referenced by RUN_LOG.md.
# Checkpoints, model binaries, stdout/stderr, provider-call payloads, and all
# other run directories remain ignored.
!logs/run_20260831T131357Z/
logs/run_20260831T131357Z/*
!logs/run_20260831T131357Z/run_meta.json
!logs/run_20260831T131357Z/summary.json
!logs/run_20260831T131357Z/iteration_*.json
!logs/run_20260831T131357Z/experiment_history.jsonl
!logs/run_20260831T131357Z/research_trajectory.json
!logs/run_20260831T131357Z/tree_snapshot.json
!logs/run_20260831T131357Z/best/
logs/run_20260831T131357Z/best/*
!logs/run_20260831T131357Z/best/config.json
!logs/run_20260831T131357Z/best/metrics.json
