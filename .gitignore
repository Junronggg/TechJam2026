# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Local secrets and machine-specific settings
.env

# KuaiRand data and downloaded archives (never commit competition data)
data/*
!data/.gitkeep
*.tar.gz
*.zip

# Generated experiment outputs
artifacts/*
!artifacts/.gitkeep
logs/*
!logs/.gitkeep
submissions/*
!submissions/.gitkeep
runs/*
!runs/.gitkeep
# Keep only compact validation evidence used by the autonomous policy builder.
!runs/rolling_validation/
runs/rolling_validation/*
!runs/rolling_validation/summary.json
!runs/rolling_multitask_like/
runs/rolling_multitask_like/*
!runs/rolling_multitask_like/summary.json
!runs/rolling_dcnv2/
runs/rolling_dcnv2/*
!runs/rolling_dcnv2/summary.json
!runs/sequence_placebo/
runs/sequence_placebo/*
!runs/sequence_placebo/summary.json
!runs/sequence_placebo/summary_author_positive_recency.json
!runs/candidate_history_followup/
runs/candidate_history_followup/*
!runs/candidate_history_followup/summary.json
!runs/rolling_constant_context/
runs/rolling_constant_context/*
!runs/rolling_constant_context/summary.json
!runs/global_context_multiseed/
runs/global_context_multiseed/*
!runs/global_context_multiseed/summary.json
!runs/global_context_ensemble/
runs/global_context_ensemble/*
!runs/global_context_ensemble/summary.json
!runs/lightweight_sequence_ablation/
runs/lightweight_sequence_ablation/*
!runs/lightweight_sequence_ablation/summary.json
!runs/pairwise_multitask_ablation/
runs/pairwise_multitask_ablation/*
!runs/pairwise_multitask_ablation/summary.json
!runs/candidate_history_audit/
runs/candidate_history_audit/*
!runs/candidate_history_audit/summary.json
best/*
!best/.gitkeep

