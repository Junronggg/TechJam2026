# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Local secrets and machine-specific settings
.env

# KuaiRand data and downloaded archives (never commit competition data)
data/*
!data/.gitkeep
*.tar.gz
*.zip

# Generated experiment outputs. Only the final evidence package is uploadable.
artifacts/*
!artifacts/.gitkeep
!artifacts/best_config.json
!artifacts/best_metrics.json
!artifacts/best_manifest.json
logs/*
!logs/.gitkeep
!logs/run_final/
!logs/run_final/summary.json
!logs/run_final/research_trajectory.json
!logs/run_final/experiment_history.jsonl
!logs/run_final/iteration_*.json
submissions/*
!submissions/.gitkeep
!submissions/final.csv
runs/*
best/*

# Local research notes and machine-only archives.
docs/*
analysis/*.html
analysis/*.ipynb
local_archive/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
