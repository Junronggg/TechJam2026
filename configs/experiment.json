{
  "model": "fm",
  "training_objective": "bce",
  "hyperparameters": {
    "embedding_dim": 16,
    "validation_metric": "primary",
    "blend_mode": "rank",
    "learning_rate": 0.001,
    "epochs": 40,
    "l2": 0.000001,
    "batch_size": 8192,
    "patience": 4,
    "seed": 0,
    "ensemble_size": 1,
    "ensemble_seed_set": "sequential",
    "negatives_per_positive": 1,
    "negative_sampling_strategy": "random",
    "hard_negative_pool_size": 0,
    "dropout": 0.1,
    "sequence_length": 20,
    "auxiliary_weight": 0.2,
    "graph_layers": 2
  },
  "features": {
    "user_long_view_rate": false,
    "item_long_view_rate": false,
    "continuous_history_stats": false,
    "user_tab_long_view_rate": false,
    "duration_fine_bucket": false,
    "tag": false,
    "hour": false,
    "weekday": false,
    "upload_age_bucket": false,
    "freshness_decay": false,
    "user_activity": false,
    "video_type": false,
    "time_decay_item_popularity": false,
    "time_decay_author_popularity": false,
    "time_decay_tag_popularity": false,
    "recent_history_similarity": false,
    "user_tag_impression_count": false,
    "user_tag_long_view_rate": false,
    "author_impression_count": false,
    "author_long_view_count": false,
    "author_long_view_rate": false,
    "user_author_impression_count": false,
    "user_author_long_view_count": false,
    "user_author_long_view_rate": false
  },
  "lightgbm_hyperparameters": {
    "learning_rate": 0.05,
    "num_leaves": 31,
    "n_estimators": 500,
    "min_child_samples": 100,
    "subsample": 0.9,
    "colsample_bytree": 0.9,
    "reg_lambda": 0.0001,
    "early_stopping_rounds": 30
  }
}
