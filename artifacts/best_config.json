{
  "model": "ensemble",
  "training_objective": "hybrid",
  "hyperparameters": {
    "embedding_dim": 16,
    "learning_rate": 0.0003,
    "epochs": 40,
    "l2": 1e-06,
    "batch_size": 8192,
    "patience": 4,
    "pairs_per_positive": 1,
    "negative_sampling": "random",
    "hard_negative_candidates": 2,
    "deepfm_hidden_dim": 32,
    "hybrid_bpr_weight": 0.5,
    "ensemble_deepfm_weight": 0.6,
    "ensemble_normalization": "fm_zscore_deepfm_rank",
    "auxiliary_loss_weight": 0.1,
    "auxiliary_signals": "like",
    "dcn_cross_layers": 2,
    "dcn_low_rank": 16,
    "sequence_length": 16,
    "feature_control": "real",
    "seed": 0
  },
  "features": {
    "user_long_view_rate": false,
    "item_long_view_rate": false,
    "continuous_history_stats": false,
    "user_tab_long_view_rate": false,
    "user_tab_cross": false,
    "user_author_cross": false,
    "user_recent_3d_activity": false,
    "item_recent_3d_exposure": false,
    "prior_video_positive": false,
    "author_positive_recency": false,
    "prior_video_count": false,
    "previous_author_same": false,
    "prior_video_exposure": false,
    "author_recency": false,
    "global_context": false,
    "video_tag": false,
    "video_upload_type": false,
    "user_active_degree": false,
    "user_register_days_range": false,
    "duration_semantic_bucket": false,
    "video_music_type": false,
    "video_tag_components": false
  },
  "lightgbm_hyperparameters": {
    "learning_rate": 0.05,
    "num_leaves": 31,
    "n_estimators": 500,
    "min_child_samples": 100,
    "subsample": 0.9,
    "colsample_bytree": 0.9,
    "reg_lambda": 0.0001,
    "early_stopping_rounds": 30
  }
}
